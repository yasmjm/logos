APP_NAME=Logos
# development | test | production (em production, JWT_SECRET é obrigatório)
APP_ENV=development
DEBUG=false
DATABASE_URL=postgresql+psycopg://logos:logos@localhost:5433/logos
# Chave da ingestão (header X-API-Key em POST /incidents). Vazia = ingestão fechada. Gere uma com:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_API_KEY=
# Segredo que assina os tokens dos analistas (HS256), com no mínimo 32 caracteres.
# Sem ele, o app não sobe em production; em development, usa um valor fixo e avisa no log.
# Gere um com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
